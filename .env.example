# M0 — API process
NODE_ENV=development
PORT=3000

# M1 — Auth (cloud MongoDB — replace with your Atlas/connection string; never commit real secrets)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/videoprocess

# Redis via Compose (use localhost for npm run start:dev; Compose overrides to redis://redis:6379 for api)
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=5h
BCRYPT_COST=12
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_LIMIT=10
THROTTLE_USER_LIMIT=20

# M2 — Upload / AWS S3 / FFprobe
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket
S3_ORIGINAL_PREFIX=originals/
MAX_UPLOAD_BYTES=524288000
FFPROBE_PATH=ffprobe
