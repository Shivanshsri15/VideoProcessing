# API
NODE_ENV=development
PORT=3000

# Cloud MongoDB — replace with your connection string; never commit real secrets
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/videoprocess

# Redis (localhost for local API; Compose overrides to redis://redis:6379 for api/worker)
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=5h
BCRYPT_COST=12
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_LIMIT=10
THROTTLE_USER_LIMIT=20

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket
S3_ORIGINAL_PREFIX=originals/
S3_THUMBNAIL_PREFIX=thumbnails/
MAX_UPLOAD_BYTES=524288000
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# BullMQ / worker (keep concurrency at 1 for system-wide one-at-a-time processing)
VIDEO_QUEUE_NAME=video-processing
VIDEO_WORKER_CONCURRENCY=1
TASK_STATUS_CACHE_TTL_SEC=86400

# Email (Mailhog locally / Compose; leave USER/PASS empty for Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Video Process <noreply@localhost>"
